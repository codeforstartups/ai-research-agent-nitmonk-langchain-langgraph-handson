# =============================================================================
# AI Research & Analysis Agent — environment configuration
# Copy this file to `.env` and fill in the values you have.
# Everything is optional at first: phases run with mocks/local models until a
# real credential is present, then transparently switch to the live service.
# =============================================================================

# ---- Which providers to use (pluggable: anthropic | openai | google) --------
# The chat model provider used by the agent's reasoning nodes.
LLM_PROVIDER=anthropic
# The embeddings provider (google | openai | fastembed). `fastembed` runs
# locally with no API key and is the zero-cost default for the RAG phases.
EMBEDDINGS_PROVIDER=fastembed

# ---- Model names (override the sensible per-provider defaults if you like) --
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4.1
GOOGLE_MODEL=gemini-2.5-pro

# ---- LLM provider API keys --------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Thordata (live web-data acquisition, used by the Web Research MCP) ------
# Filled in once your Thordata account is provisioned. Until then the Web
# Research MCP falls back to a deterministic offline fixture.
THORDATA_API_KEY=
THORDATA_BASE_URL=https://api.thordata.com
THORDATA_TIMEOUT_SECONDS=30

# ---- Langfuse (observability / tracing) -------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to `false` to hard-disable tracing even if keys are present.
LANGFUSE_ENABLED=true

# ---- Retrieval / vector store paths -----------------------------------------
VECTORSTORE_DIR=data/vectorstore
KNOWLEDGE_DIR=data/knowledge

# ---- Runtime behaviour ------------------------------------------------------
# Global request timeout (seconds) for outbound model/tool calls.
REQUEST_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
